config_version=5

[application]

config/name="Match Three"
config/description="Bejeweled-style match-three game (Godot/C#)."
config/features=PackedStringArray("4.7", "C#")
config/icon="res://Assets/Icon/icon.png"
run/main_scene="res://Scenes/Menu.tscn"

[autoload]

Game="*res://View/Game.cs"
UiClick="*res://View/UiClick.cs"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="MatchThree"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
